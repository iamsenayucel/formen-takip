# PostgreSQL — yalnızca docker-compose.db.yml dahil edildiğinde (aynı-host
# yerel Postgres container'ı) kullanılır; bu değerlerden DATABASE_URL için
# bir varsayılan inşa edilir (bkz. docker-compose.yml).
POSTGRES_USER=formen
POSTGRES_PASSWORD=formen
POSTGRES_DB=formen_takip
# docker-compose.db.yml'in Postgres portunu bind ettiği adres. Varsayılan
# 127.0.0.1 (yalnızca bu host'tan erişilebilir). Backend ayrı bir sunucuda
# çalışıyorsa bu host'un private-network adresine (örn. 10.0.3.30) ayarlayın
# — ASLA 0.0.0.0 yapmayın (bkz. README "Network / Firewall").
POSTGRES_BIND=127.0.0.1

# Backend'in database bağlantısı. Boş bırakılırsa yukarıdaki POSTGRES_* ile
# yerel "postgres" servisine bağlanılır (docker-compose.db.yml gerekir).
# Database ayrı bir sunucuda veya yönetilen bir serviste ise burada tam
# bağlantı dizesini verin — docker-compose.db.yml dahil edilmese bile bu
# değer esas alınır:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db.internal.company:5432/formen_takip
DATABASE_URL=

# Frontend'in backend'e ulaştığı adres — nginx container'ı içinde,
# runtime'da /etc/nginx/conf.d/default.conf'a render edilir (bkz.
# frontend/default.conf.template), image yeniden build edilmez. Aynı host
# için varsayılan yeterlidir. Backend ayrı bir sunucudaysa değiştirin:
#   BACKEND_UPSTREAM=https://api.internal.company
BACKEND_UPSTREAM=http://backend:8000

# docker-compose.prod.yml'in backend portunu bind ettiği adres — aynı POSTGRES_BIND
# mantığı (bkz. yukarısı). Varsayılan 127.0.0.1 (yalnızca bu host'tan erişilebilir,
# docs sayfası localhost:8000/docs olarak yine çalışır). Frontend ayrı bir
# sunucudaysa bu host'un private-network adresine ayarlayın — ASLA 0.0.0.0 yapmayın.
BACKEND_BIND=127.0.0.1

# frontend'in 8080 portunu bind ettiği adres — aynı BACKEND_BIND/POSTGRES_BIND
# mantığı. Varsayılan 127.0.0.1: edge (Caddy) frontend'e bu yayınlanan port
# üzerinden değil, Compose'un dahili DNS'i üzerinden ("frontend:8080") ulaşır,
# bu yüzden 0.0.0.0 yapmak yalnızca http://sunucu:8080'i Caddy/HTTPS'i atlayarak
# genele açar. Yalnızca ayrı bir host (başka bir sunucu, edge'i devre dışı
# bırakan kurumsal bir LB) frontend'e doğrudan erişmek zorundaysa bu host'un
# private-network adresine ayarlayın — ASLA 0.0.0.0 yapmayın.
FRONTEND_BIND=127.0.0.1

# Edge proxy (docker-compose.prod.yml "edge" servisi, Caddy) — internetten
# erişilebilecek TEK servis (80/443). SITE_DOMAIN'e otomatik Let's Encrypt
# sertifikası çıkarır; DNS bu sunucuyu göstermeli ve 80/443 gerçekten internete
# açık olmalı. Gerçek bir domain yoksa (yerel test için) SITE_DOMAIN=localhost
# kullanın — Caddy bu durumda kendi dahili CA'sıyla self-signed sertifika üretir.
# Zorunludur: bkz. README "Network / Firewall" / "HTTPS".
SITE_DOMAIN=

# docker-compose.yml varsayılanı "production" (fail-closed: gerçek OIDC config
# olmadan başlamaz). Yalnızca "development" + AUTH_BYPASS=true kombinasyonu
# demo bypass modunu açar — bkz. README "Development Demo Mode". Başka hiçbir
# değer AUTH_BYPASS=true ile birlikte kullanılamaz (startup fail).
ENVIRONMENT=production

# Development/demo only. Cloudflare Tunnel gibi geçici bir linkle, gerçek
# Keycloak/SSO'ya bağlanmadan sentetik veriyle arayüzü göstermek için — bkz.
# README "Development Demo Mode". Production'da kesinlikle true olamaz
# (ENVIRONMENT=production iken backend başlamayı reddeder).
AUTH_BYPASS=false
VITE_AUTH_BYPASS=false

# Red Hat SSO / Keycloak (OIDC) — bkz. README "Authentication Architecture".
# ENVIRONMENT=production'da (docker-compose.yml varsayılanı) OIDC_ISSUER_URL ve
# OIDC_AUDIENCE zorunludur; boş bırakılırsa backend fail-closed olarak başlamaz.
# Gerçek kurumsal değerler burada DEĞİL, yalnızca yerel/gizli .env dosyasında saklanmalı.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
# Backend'in JWKS'i issuer'ın /.well-known/openid-configuration'ından keşfetmesi
# yeterli olmadığı durumlarda override etmek için (opsiyonel).
OIDC_JWKS_URI=
# Uygulama içi stabil kimlik ilişkilendirmesi için kullanılacak access token claim'i.
# Kurumun Red Hat SSO konfigürasyonu doğrulandıktan sonra "employee_id" gibi bir
# claim'e geçirilebilir; varsayılan OIDC standardı "sub"dur.
OIDC_USER_ID_CLAIM=sub
# Frontend (Authorization Code + PKCE) — bu değerler container start'ta
# frontend/config.js'e render edilir (bkz. config.js.template,
# runtimeConfig.ts), image build-time'da gömülmez: bir domain değişikliği
# yeniden build gerektirmez, yalnızca container'ı yeniden başlatmak yeterlidir.
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/login
OIDC_SCOPE=openid profile email

# --- Yerel geliştirme: local Keycloak (docker-compose.dev.yml) ---
# Yukarıdaki OIDC_ISSUER_URL/OIDC_AUDIENCE/OIDC_CLIENT_ID PRODUCTION için
# (gerçek Red Hat SSO). `docker compose -f docker-compose.yml -f
# docker-compose.db.yml -f docker-compose.dev.yml up` çalıştırıldığında
# `docker-compose.dev.yml` gerçek bir Keycloak konteyneri başlatır ve
# backend/frontend'i BUNLAR yerine kendi içinde tanımlı yerel değerlere
# yönlendirir — bu satırları elle doldurmanız GEREKMEZ. Production komutu
# (`-f docker-compose.yml -f docker-compose.prod.yml`) bu dosyayı hiç
# içermez, yerel Keycloak asla production'a karışmaz. Yalnızca farklı bir dev
# realm/client/audience adı kullanmak isterseniz aşağıdakileri override edin
# (aksi halde varsayılanlar yeterli):
# OIDC_DEV_HOSTNAME=keycloak
# OIDC_DEV_REALM=formen-dev
# OIDC_DEV_CLIENT_ID=formen-frontend
# OIDC_DEV_AUDIENCE=formen-backend
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
#
# Tek manuel adım: "keycloak" hostname'inin tarayıcıdan da çözülebilmesi için
# hosts dosyanıza bir satır eklemeniz gerekir (bkz. README "Authentication
# Architecture > Yerel Geliştirme: Local Keycloak"):
#   Windows: C:\Windows\System32\drivers\etc\hosts
#   macOS/Linux: /etc/hosts
#   127.0.0.1 keycloak
#
# Gerçek Red Hat SSO'ya geçerken: `docker compose -f docker-compose.yml -f
# docker-compose.prod.yml up -d` kullanın (docker-compose.dev.yml'i hiç
# içermez, dolayısıyla local Keycloak hiç başlamaz) ve yukarıdaki
# OIDC_ISSUER_URL/OIDC_AUDIENCE/OIDC_CLIENT_ID'yi gerçek kurumsal değerlerle
# doldurun.

# SAP entegrasyonu (bölüm 24) — Faz 1'de KULLANILMAZ, yalnızca gelecekteki
# SAPDataProvider implementasyonu için yer tutucu. Boş bırakılabilir.
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# Tespitler modülü — yapay zekâ analizi (bkz. README "Tespitler Modülü").
# LLM_ENABLED=false veya LLM_API_KEY boşsa backend, önceden tanımlanmış demo analiz
# çıktıları döndürür; uygulama bozulmaz. Gerçek bir LLM sağlayıcısına bağlanmak için
# LLM_ENABLED=true yapın ve OpenAI uyumlu bir chat-completions uç noktasının bilgilerini girin.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# Aşama 2 — tool calling destekli analiz ajanı (bkz. README "Tespitler Modülü — Aşama 2").
# LLM_ANALYSIS_MODE: single_context (Aşama 1 yöntemi) | tool_calling (yeni ajan yöntemi).
# LLM_TOOL_CALLING_ENABLED=false ise tool_calling isteği bile gelse single_context'e düşülür.
# LLM_DEMO_TOOL_CALLING_ENABLED=true iken API anahtarı olmadan da tool_calling modu, gerçek
# sentetik araçları çalıştırıp demo bir analizle sonuçlanır (uygulama hiçbir zaman bozulmaz).
LLM_ANALYSIS_MODE=single_context
LLM_TOOL_CALLING_ENABLED=true
LLM_DEMO_TOOL_CALLING_ENABLED=true
LLM_MAX_TOOL_CALLS=10
LLM_MAX_ANALYSIS_STEPS=12
LLM_TOOL_TIMEOUT_SECONDS=10
LLM_ANALYSIS_TIMEOUT_SECONDS=60
LLM_MAX_DATE_RANGE_DAYS=365

# Formen Aylık Performans Raporu — kalıcı dosya depolama (bkz. README "Rapor Storage
# Mimarisi"). REPORT_STORAGE_PROVIDER=local (varsayılan) iken PDF'ler backend
# container'ının ephemeral bir dizininde tutulur — yalnızca yerel geliştirme içindir.
# Production'da (ENVIRONMENT=production) REPORT_STORAGE_PROVIDER=s3 ZORUNLUDUR ve
# REPORTS_S3_BUCKET boş bırakılamaz; aksi halde backend fail-closed başlamayı reddeder
# (bkz. app/core/config.py). AWS kimlik bilgisi burada YOKTUR ve olmamalıdır — production
# konteyneri bir IAM Role üzerinden (boto3 varsayılan credential chain) kimliklenir.
REPORT_STORAGE_PROVIDER=local
AWS_REGION=
REPORTS_S3_BUCKET=
# "local" modda PDF'lerin backend container'ı içinde tutulduğu dizin —
# development-only, production'da REPORT_STORAGE_PROVIDER=s3 zorunlu olduğu
# için bu değer o zaman hiç kullanılmaz.
LOCAL_REPORT_STORAGE_DIR=.local_reports

# CloudFront Signed URL — private S3 origin için browser erişimi (bkz. README).
# Bu değerler IT/DevOps tarafından S3+CloudFront provizyonlandıktan sonra sağlanır;
# boş bırakıldığında rapor erişim endpoint'i CloudFront yerine backend üzerinden
# authenticated bir proxy'ye düşer (hâlâ güvenli, yalnızca CDN katmanı devre dışı).
# CLOUDFRONT_PRIVATE_KEY bir PEM private key'dir — GERÇEK DEĞERİ ASLA .env'e veya
# repoya yazmayın, yalnızca merkezi sır yönetimi servisinden production'a inject edilir.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
REPORT_SIGNED_URL_TTL_SECONDS=300

# Kurumsal SMTP — aylık formen raporunun ilgili formene + şefe e-posta ile gönderimi.
# SMTP_ENABLED=false iken email job'ı hiçbir gönderim denemez (raporlar PENDING kalır,
# üretim/erişim etkilenmez). Gerçek SMTP bilgileri IT/DevOps tarafından sağlanana kadar
# boş bırakın — SMTP_PASSWORD'ü ASLA burada gerçek değerle doldurmayın.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_MAX_RETRY_COUNT=5
EMAIL_STALE_CLAIM_TIMEOUT_SECONDS=900
ANOMALY_STALE_CLAIM_TIMEOUT_SECONDS=600

# --- Ortam / gizli bilgi dosyaları ---
# .env dosyaları gerçek (yerel) yapılandırma taşır; yalnızca .env.example şablonları
# repoya dahil edilir.
.env
.env.*
!.env.example
!backend/.env.example

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Yerel geliştirme rapor storage'ı (REPORT_STORAGE_PROVIDER=local) — yalnızca dev/test
# scratch, kalıcı storage Private S3'tür (bkz. app/services/storage).
.local_reports/
backend/.local_reports/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local
playwright-report/
test-results/

# Playwright smoke script'lerinin varsayılan ekran görüntüsü çıktısı (bkz.
# frontend/scripts/smoke_helpers.mjs::resolveShotDir) — SMOKE_SHOT_DIR ile değiştirilebilir.
frontend/scripts/.smoke-output/

# --- Loglar ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Yerel veritabanı yedekleri ---
*.dump

# --- CI test çıktısı (backend-ci.yml --junitxml) — yerelde de aynı komutla üretilir ---
pytest-results.xml

# --- Geçici/lokal scratch dizinleri (uygulamanın parçası değil) ---
.tmp-corvus-word/

# --- Editör / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- İşletim sistemi ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (AI asistan config/prompt/memory dosyaları — repoya dahil edilmez) ---
.claude/
CLAUDE.md

# --- Yerel oturum/token dökümleri ---
token.txt

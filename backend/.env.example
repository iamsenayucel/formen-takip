# Yerel (Docker'sız) geliştirme için şablon. Kopyalayıp `.env` olarak kaydedin:
#   cp .env.example .env
#
# DATABASE_URL, Docker Compose'un Postgres'i host'a map'lediği 5433 portunu
# hedefler (bkz. docker-compose.yml). Farklı bir yerel Postgres kullanıyorsanız
# bu değeri kendi bağlantınıza göre düzenleyin.

ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://formen:formen@localhost:5433/formen_takip
CORS_ORIGINS=["http://localhost:5173"]

# Development/demo only — skips OIDC validation and returns a synthetic
# "dev-demo-user" identity. Only takes effect when ENVIRONMENT=development;
# any other environment with AUTH_BYPASS=true refuses to start (fail-closed,
# see app/core/config.py). Bkz. README "Development Demo Mode".
AUTH_BYPASS=false

# Red Hat SSO / Keycloak (OIDC) — yerel bir Keycloak instance'ınız yoksa boş
# bırakabilirsiniz; backend ayağa kalkar ama korumalı endpoint'ler 401 döner
# (fail-closed — hiçbir koşulda otomatik bypass yoktur, bkz. README).
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_USER_ID_CLAIM=sub

# Formen aylık rapor storage — "local" yerel geliştirme için varsayılandır (PDF'ler
# ./local_report_storage_dir altında tutulur, AWS gerekmez). Production'da "s3" zorunlu
# — bkz. kök .env.example ve README "Rapor Storage Mimarisi".
REPORT_STORAGE_PROVIDER=local
AWS_REGION=
REPORTS_S3_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
REPORT_SIGNED_URL_TTL_SECONDS=300

# SMTP devre dışıyken email job'ı raporları PENDING bırakır, hata vermez.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_MAX_RETRY_COUNT=5
EMAIL_STALE_CLAIM_TIMEOUT_SECONDS=900
ANOMALY_STALE_CLAIM_TIMEOUT_SECONDS=600

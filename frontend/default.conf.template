# Processed by the official nginx image's built-in entrypoint hook
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) at container start:
# envsubst renders this into /etc/nginx/conf.d/default.conf using only the
# environment variables actually referenced below, so nginx's own $-prefixed
# variables (e.g. $host, $remote_addr) are left untouched.
#
# BACKEND_UPSTREAM makes the backend address a runtime setting instead of a
# build-time one — same host ("http://backend:8000") or a different server
# ("https://api.internal.company") without rebuilding this image.
server {
    # 8080, not 80: this image runs as a non-root user (nginx-unprivileged
    # base — see Dockerfile), which can't bind a port below 1024.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # A *static* proxy_pass hostname is resolved once, at nginx startup, and
    # then cached for the life of the process — if BACKEND_UPSTREAM's DNS
    # record changes later (a recreated "backend" container gets a new
    # Compose-network IP, a moved API server gets a new address) nginx keeps
    # using the stale IP until reloaded, and a name that doesn't resolve yet
    # at startup crashes the container outright. Routing proxy_pass through a
    # variable forces per-request resolution via `resolver` instead (cached
    # only for `valid`), which also means a temporarily-unresolvable backend
    # returns a 502 rather than preventing nginx from starting at all.
    resolver 127.0.0.11 valid=30s;

    # Tek tanım noktası: CSP metni aşağıdaki 4 location'da (config.js, index.html,
    # assets, SPA fallback) tekrar tekrar yazılmak yerine buradan referans alınır.
    # /api/ location'ı bilinçli olarak buraya dahil değil — o location kendi
    # add_header'ını tanımlamadığından hiçbir header'ı miras almaz ve backend'in
    # (app/core/security_headers.py) kendi ürettiği header'lar hiçbir değişikliğe
    # uğramadan olduğu gibi geçer; aksi halde her iki katman da aynı response'a
    # farklı bir Content-Security-Policy eklemiş olurdu.
    #
    # script-src'teki hash, index.html'deki tema-flash-önleme inline <script>'inin
    # (yalnız bu tek blok) SHA-256'sıdır — Vite production build'i bu script'i
    # minify/değiştirmeden bırakır (dist/index.html ile doğrulandı). O script
    # satırları değişirse bu hash yeniden hesaplanmalıdır, aksi halde CSP onu
    # sessizce bloklar (script-src'te 'unsafe-inline' KULLANILMIYOR — script-src'te
    # dinamik olmayan tek bir statik blok olduğu için hash mümkün ve tercih edildi).
    #
    # style-src'teki 'unsafe-inline' bilinçli bir istisnadır: React ağacında 850+
    # adet dinamik `style={{...}}` (Recharts grafikleri, tema renkleri vb.) kullanılıyor;
    # değerler her render'da değişebildiğinden hash mümkün değil, ve CSP nonce'ları
    # yalnızca <style>/<link> öğelerine uygulanır — style="" attribute'una browser
    # tarafında nonce desteği yoktur. Bu yüzden style-src için 'unsafe-inline'
    # kaçınılmazdır (script-src'te DEĞİL, yalnızca style-src'te).
    #
    # connect-src'teki __OIDC_ISSUER_ORIGIN__, oidc-client-ts'in token/discovery
    # çağrılarını tarayıcıdan DOĞRUDAN (nginx proxy'si olmadan) issuer origin'ine
    # yaptığı için gereklidir. Bilerek VITE_OIDC_ISSUER_URL'in TAMAMI değil yalnız
    # origin'i (scheme://host:port) kullanılıyor: CSP source-expression'da path
    # verilirse (ör. "http://keycloak:8081/realms/formen-dev") tarayıcı yalnız o
    # path'e TAM eşleşen isteklere izin veriyor — gerçek Chromium'da doğrulandı,
    # discovery isteği (".../realms/formen-dev/.well-known/openid-configuration")
    # farklı bir alt path olduğu için engellenip CSP violation üretti. envsubst
    # burada path'siz origin'i BİLEMEZ (yalnız literal ${VAR} substitution yapar);
    # bu yüzden origin, container başlarken 40-runtime-config.sh tarafından
    # VITE_OIDC_ISSUER_URL'den hesaplanıp bu placeholder'ın yerine yazılıyor.
    set $security_headers_csp "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-pScmX0iOimHvyoiSCr8uGjX63a9RRgXHmXoLoyzMNsU='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' __OIDC_ISSUER_ORIGIN__; frame-src 'none'";

    location /api/ {
        # No path after the variable: when proxy_pass's target is a
        # variable, nginx does NOT do its usual "replace the matched
        # location prefix with the proxy_pass URI" — it passes the original
        # request URI through unchanged instead. Backend routes already live
        # under /api/v1/... (see app/api/v1/router.py), i.e. identical to
        # what the client requested, so passing it through unchanged is
        # exactly right; adding "/api/" here (as an earlier version of this
        # file did) silently doubled the prefix into /api/api/v1/... and
        # 404'd every request — caught by an end-to-end proxy test, not by
        # nginx -t or a bare 502 check, which both looked fine regardless.
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        # proxy_pass's target is a variable, so nginx can't tell at config-parse
        # time whether BACKEND_UPSTREAM is http:// or https://; these proxy_ssl_*
        # directives are inert for plain-HTTP upstreams and only take effect when
        # it's https://. proxy_ssl_server_name defaults to off, meaning nginx
        # otherwise opens the TLS connection with NO SNI — any upstream TLS
        # endpoint that selects a certificate/vhost by SNI (a shared load
        # balancer, another nginx/Caddy doing name-based routing, a corporate
        # TLS-terminating proxy) then rejects or misroutes the handshake, which
        # surfaces here as a 502. Enabling it also makes nginx use the upstream
        # hostname (not IP) for SNI and, if proxy_ssl_verify is turned on, for
        # certificate verification.
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /config.js {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy $security_headers_csp always;
    }

    # The HTML shell selects the content-hashed JavaScript bundle. It must be
    # revalidated after every deployment; otherwise an already-open browser
    # can keep running a bundle built against the previous API contract.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy $security_headers_csp always;
    }

    # Vite asset names contain a content hash, so these files are safe to cache
    # indefinitely. A new deployment points index.html at a new filename.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy $security_headers_csp always;
        try_files $uri =404;
    }

    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy $security_headers_csp always;
        try_files $uri $uri/ /index.html;
    }
}

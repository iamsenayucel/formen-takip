# Yerel (Docker'sız) geliştirme için şablon. Kopyalayıp `.env` olarak kaydedin:
#   cp .env.example .env
#
# Red Hat SSO / Keycloak (OIDC) — bkz. README "Authentication Architecture".
# Gerçek kurumsal Red Hat SSO erişimi yoksa bu değerleri boş bırakabilirsiniz;
# uygulama "SSO yapılandırması eksik" ekranı gösterir (fail-closed, backdoor yoktur).
VITE_OIDC_ISSUER_URL=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email
